# Stage05 THREE INDEPENDENT Telegram bots. Example ONLY: never put values
# in this file, a GitHub commit, comment, artifact, stdout or shared logs.
# Fill secrets only in the owner's Windows process after separate approval.
ZS_SIGNALS_BOT_TOKEN=
ZS_SIGNALS_CHAT_ID_A=
ZS_SIGNALS_CHAT_ID_B=
ZS_INTERACTIVE_BOT_TOKEN=
ZS_INTERACTIVE_ALLOWED_USER_IDS=
ZS_INTERACTIVE_ALLOWED_CHAT_IDS=
ZS_ANALYTICS_BOT_TOKEN=
ZS_ANALYTICS_CHAT_ID=

# ALL OFF: credentials alone NEVER start Telegram or enable sending.
ZS_TELEGRAM_SEND_ENABLED=false
ZS_SIGNALS_DISPATCH_ENABLED=false
ZS_ANALYTICS_DISPATCH_ENABLED=false
ZS_INTERACTIVE_POLLING_ENABLED=false
ZS_INTERACTIVE_REPLY_ENABLED=false
